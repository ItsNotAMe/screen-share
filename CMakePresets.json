{
  "version": 6,
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/build/webrtc/checkout/src/third_party/llvm-build/Release+Asserts/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/build/webrtc/checkout/src/third_party/llvm-build/Release+Asserts/bin/clang-cl.exe",
        "CMAKE_LINKER": "${sourceDir}/build/webrtc/checkout/src/third_party/llvm-build/Release+Asserts/bin/lld-link.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/build/webrtc/checkout/src/third_party/ninja/ninja.exe",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/Qt/6.10.3/msvc2022_64",
        "Vulkan_INCLUDE_DIR": "${sourceDir}/build/Vulkan-Headers/include",
        "SCREENSHARE_PACKAGE_PORTABLE_ON_BUILD": "OFF",
        "SCREENSHARE_ENABLE_RELEASE_LTO": "OFF"
      }
    },
    {
      "name": "native-debug",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL",
        "SCREENSHARE_WEBRTC_ARTIFACT_DIR": "${sourceDir}/build/webrtc/checkout/src/out/screenshare-debug"
      }
    },
    {
      "name": "native-release",
      "inherits": "native-base",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "SCREENSHARE_WEBRTC_ARTIFACT_DIR": "${sourceDir}/build/webrtc/checkout/src/out/screenshare-release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "native-debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "native-release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug", "jobs": 8 },
    { "name": "native-release", "configurePreset": "native-release", "jobs": 8 },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
